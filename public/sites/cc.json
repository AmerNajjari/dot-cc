ive\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0648\u0627\u0644\u0625\u0628\u062f\u0627\u0639\u003c/span\u003e\u003c/label\u003e\u003cinput type=\"radio\" name=\"need\" id=\"need-both\" value=\"Both\"\u003e\u003clabel for=\"need-both\"\u003e\u003cspan class=\"en\"\u003eBoth\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0627\u0644\u0627\u062b\u0646\u0627\u0646 \u0645\u0639\u0627\u064b\u003c/span\u003e\u003c/label\u003e\u003cinput type=\"radio\" name=\"need\" id=\"need-unsure\" value=\"Not sure yet\" checked\u003e\u003clabel for=\"need-unsure\"\u003e\u003cspan class=\"en\"\u003eNot sure yet\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0644\u0633\u062a \u0645\u062a\u0623\u0643\u062f\u0627\u064b \u0628\u0639\u062f\u003c/span\u003e\u003c/label\u003e\u003c/div\u003e\u003c/fieldset\u003e\n\u003cdiv class=\"field\" id=\"fx-msg\"\u003e\u003clabel for=\"fMsg\"\u003e\u003cspan class=\"en\"\u003eWhere are you today?\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0623\u064a\u0646 \u062a\u0642\u0641 \u0627\u0644\u064a\u0648\u0645\u061f\u003c/span\u003e\u003c/label\u003e\n\u003ctextarea id=\"fMsg\" name=\"message\" required\u003e\u003c/textarea\u003e\n\u003cspan class=\"err\" role=\"alert\"\u003e\u003cspan class=\"en\"\u003eAdd a short message\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0623\u0636\u0641 \u0631\u0633\u0627\u0644\u0629 \u0642\u0635\u064a\u0631\u0629\u003c/span\u003e\u003c/span\u003e\u003c/div\u003e\n\n\u003cdiv class=\"send\"\u003e\n\u003cbutton type=\"submit\" id=\"sendBtn\"\u003e\u003cspan class=\"idle\"\u003e\u003cspan class=\"en\"\u003eSend message\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0623\u0631\u0633\u0644 \u0627\u0644\u0631\u0633\u0627\u0644\u0629\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"busy\" hidden\u003e\u003cspan class=\"en\"\u003eSending\u2026\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u062c\u0627\u0631\u064d \u0627\u0644\u0625\u0631\u0633\u0627\u0644\u2026\u003c/span\u003e\u003c/span\u003e\u003c/button\u003e\n\u003csmall\u003e\u003cspan class=\"en\"\u003eWe use your details only to reply to you.\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0646\u0633\u062a\u062e\u062f\u0645 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0644\u0644\u0631\u062f \u0639\u0644\u064a\u0643 \u0641\u0642\u0637.\u003c/span\u003e\u003c/small\u003e\n\u003c/div\u003e\n\u003cp class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\"\u003e\u003c/p\u003e\n\u003c/form\u003e\n\n\u003cdiv class=\"done\" id=\"done\" tabindex=\"-1\"\u003e\n\u003cdiv class=\"tick\" aria-hidden=\"true\"\u003e\u003csvg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003e\u003cpath d=\"M5 12.5l4.5 4.5L19 7.5\"/\u003e\u003c/svg\u003e\u003c/div\u003e\n\u003ch3\u003e\u003cspan class=\"en\"\u003eMessage sent.\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0648\u0635\u0644\u062a\u0646\u0627 \u0631\u0633\u0627\u0644\u062a\u0643.\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan class=\"en\"\u003eThank you. We read every message, and we will reply from info@dot-cs.com.\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u0634\u0643\u0631\u0627\u064b \u0644\u0643. \u0646\u0642\u0631\u0623 \u0643\u0644 \u0631\u0633\u0627\u0644\u0629\u060c \u0648\u0633\u0646\u0631\u062f \u0639\u0644\u064a\u0643 \u0645\u0646 info@dot-cs.com.\u003c/span\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003c/section\u003e\u003cfooter\u003e\u003cdiv class=\"wrap\"\u003e\n\u003cimg src=\"data:image/png;base64,\" alt=\"dot. creative consultancy\"\u003e\n\u003cspan\u003e\u003cspan class=\"en\"\u003edot. creative consultancy | Riyadh | All rights reserved \u00a9 2026\u003c/span\u003e\u003cspan class=\"ar\" lang=\"ar\"\u003e\u003cbdi dir=\"ltr\"\u003edot.\u003c/bdi\u003e \u0644\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0625\u0628\u062f\u0627\u0639\u064a\u0629 | \u0627\u0644\u0631\u064a\u0627\u0636 | \u062c\u0645\u064a\u0639 \u0627\u0644\u062d\u0642\u0648\u0642 \u0645\u062d\u0641\u0648\u0638\u0629 \u00a9 2026\u003c/span\u003e\u003c/span\u003e\n\u003c/div\u003e\u003c/footer\u003e\u003cscript\u003e\n(function(){\n  var body=document.body, root=document.documentElement;\n  function setLang(l){\n    body.setAttribute('data-lang',l);\n    root.setAttribute('lang',l); root.setAttribute('dir',l==='ar'?'rtl':'ltr');\n    var f=document.getElementById('fLang'); if(f) f.value=(l==='ar'?'Arabic':'English');\n    try{localStorage.setItem('dotLang',l)}catch(e){}\n  }\n  var start='en';\n  try{ var q=new URLSearchParams(location.search).get('lang'); var s=localStorage.getItem('dotLang');\n       start=(q==='ar'||q==='en')?q:(s||start);}catch(e){}\n  setLang(start);\n  document.getElementById('langBtn').addEventListener('click',function(){\n    setLang(body.getAttribute('data-lang')==='ar'?'en':'ar');\n  });\n\n  var form=document.getElementById('contactForm'), box=document.getElementById('cform'),\n      btn=document.getElementById('sendBtn'), status=document.getElementById('status');\n  var T={\n    en:{fail:'The message could not be sent from this page. Email us directly at \u003ca href=\"MAILTO\"\u003einfo@dot-cs.com\u003c/a\u003e.'},\n    ar:{fail:'\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629. \u0631\u0627\u0633\u0644\u0646\u0627 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0644\u0649 \u003ca href=\"MAILTO\" dir=\"ltr\"\u003einfo@dot-cs.com\u003c/a\u003e.'}\n  };\n  var checks=[['fName','fx-name'],['fEmail','fx-email'],['fMsg','fx-msg']];\n  function validate(){\n    var first=null;\n    checks.forEach(function(c){\n      var el=document.getElementById(c[0]), wrap=document.getElementById(c[1]);\n      var ok=el.value.trim()!=='' \u0026\u0026 el.checkValidity();\n      wrap.classList.toggle('bad',!ok); el.setAttribute('aria-invalid',ok?'false':'true');\n      if(!ok \u0026\u0026 !first) first=el;\n    });\n    if(first) first.focus();\n    return !first;\n  }\n  checks.forEach(function(c){\n    document.getElementById(c[0]).addEventListener('input',function(){\n      var w=document.getElementById(c[1]); if(w.classList.contains('bad')\u0026\u0026this.checkValidity()\u0026\u0026this.value.trim()) w.classList.remove('bad');\n    });\n  });\n  function busy(on){ btn.disabled=on; btn.querySelector('.idle').hidden=on; btn.querySelector('.busy').hidden=!on; }\n  function success(){ box.classList.add('sent'); document.getElementById('done').focus(); }\n  function mailtoLink(d){\n    var lines=['Name: '+d.name,'Company: '+(d.company||''),'Email: '+d.email,'Phone: '+(d.phone||''),'Need: '+(d.need||''),'',d.message];\n    return 'mailto:info@dot-cs.com?subject='+encodeURIComponent('Enquiry from the dot. website')+'\u0026body='+encodeURIComponent(lines.join('\\n'));\n  }\n  form.addEventListener('submit',function(ev){\n    ev.preventDefault(); status.textContent=''; status.className='status';\n    if(!validate()) return;\n    var fd=new FormData(form), d={}; fd.forEach(function(v,k){d[k]=v});\n    if(d._honey){ success(); return; }\n    busy(true);\n    fetch('https://www.dot-cc.com/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(Object.assign({},d,{'form-name':'contact',source:'creative consultancy',subject:d._subject||'New enquiry from the dot. website'})).toString()})\n      .then(function(res){ if(!res.ok) throw new Error('bad status'); try{parent.postMessage({dot:'lead',site:'creative-consultancy'},'*')}catch(e){} success(); })\n      .catch(function(){\n        var l=body.getAttribute('data-lang');\n        status.className='status error';\n        status.innerHTML=T[l].fail.replace('MAILTO',mailtoLink(d));\n      })\n      .finally(function(){ busy(false); });\n  });\n})();\n\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e"